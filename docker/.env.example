DOMAIN=localhost

# Optional local postgres container credentials (used only with --profile local-db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rayaan_ecommerce

# External/managed Postgres (Arvan Cloud DB)
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rayaan_ecommerce
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_TEMP_SECRET=replace-with-strong-temp-secret

APP_BASE_URL=http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost

# Browser-side API URL (through Caddy)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
# Server-side API URL (inside Docker network)
INTERNAL_API_URL=http://backend:3002/api/v1

