# ============================================
# DOMAIN & NETWORKING
# ============================================
DOMAIN=localhost
APP_BASE_URL=http://localhost
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost

# Browser-side API URL (through Caddy reverse proxy)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
# Server-side API URL (inside Docker network)
INTERNAL_API_URL=http://backend:3002/api/v1

# ============================================
# LOCAL DATABASE CONFIGURATION
# (Used only with docker-compose --profile local-db)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rayaan_ecommerce

# ============================================
# MANAGED/EXTERNAL DATABASE CONFIGURATION
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rayaan_ecommerce
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ============================================
# SECURITY SECRETS
# ============================================
# Generate strong secrets using: openssl rand -base64 32
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_TEMP_SECRET=replace-with-strong-temp-secret

# ============================================
# SMS PROVIDER CONFIGURATION
# ============================================
SMS_PROVIDER=melipayamak
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_BODY_ID=
MELIPAYAMAK_PATTERN_API_URL=

SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAMETER_NAME=

# ============================================
# PAYMENT GATEWAYS CONFIGURATION
# ============================================
# Zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Digipay
DIGIPAY_SANDBOX=true
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_MOCK_MODE=true
DIGIPAY_SELLER_ID=
DIGIPAY_SUPPLIER_ID=

# IDPay
IDPAY_API_KEY=
IDPAY_SANDBOX=true

# ============================================
# S3 / OBJECT STORAGE CONFIGURATION (Liara, etc.)
# ============================================
STORAGE_PROVIDER=liara
LIARA_ENDPOINT=https://storage.iran.liara.space
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
LIARA_BUCKET_NAME=rayaan-shop
STORAGE_REGION=default

# ============================================
# SSL CERTIFICATES (If mounting custom certs)
# ============================================
SSL_KEY_PATH=
SSL_CERT_PATH=
