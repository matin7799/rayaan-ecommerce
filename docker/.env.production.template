# ============================================
# DOMAIN & NETWORKING
# ============================================
DOMAIN=raynew.ir
APP_BASE_URL=https://raynew.ir
FRONTEND_URL=https://raynew.ir
CORS_ORIGINS=https://raynew.ir

# Browser-side API URL (through Caddy reverse proxy)
NEXT_PUBLIC_API_URL=https://raynew.ir/api/v1
# Server-side API URL (inside Docker network)
INTERNAL_API_URL=http://backend:3002/api/v1

# ============================================
# LOCAL DATABASE CONFIGURATION
# (Used only with docker-compose --profile local-db)
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rayaan_ecommerce

# ============================================
# MANAGED/EXTERNAL DATABASE CONFIGURATION
# ============================================
DB_HOST=3cc0774f288046cfb5a3702eab7eca3a.db.arvandbaas.ir
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=default
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# ============================================
# SECURITY SECRETS
# ============================================
# Generate strong secrets using: openssl rand -base64 32
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=
JWT_TEMP_SECRET=replace-with-strong-temp-secret

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_TEMP_EXPIRY=10m

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_LENGTH=6
OTP_TTL=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW=600

# ============================================
# SMS PROVIDER CONFIGURATION
# ============================================
SMS_PROVIDER=melipayamak
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_PATTERN_API_URL=

SMSIR_API_KEY=
SMSIR_OTP_TEMPLATE_ID=
SMSIR_OTP_PARAMETER_NAME=

# ============================================
# PAYMENT GATEWAYS CONFIGURATION
# ============================================
# Zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# Digipay
DIGIPAY_SANDBOX=true
DIGIPAY_CLIENT_ID=
DIGIPAY_CLIENT_SECRET=
DIGIPAY_USERNAME=
DIGIPAY_PASSWORD=
DIGIPAY_MOCK_MODE=true
DIGIPAY_SELLER_ID=
DIGIPAY_SUPPLIER_ID=

# IDPay
IDPAY_API_KEY=
IDPAY_SANDBOX=true

# ============================================
# S3 / OBJECT STORAGE CONFIGURATION (Liara, etc.)
# ============================================
STORAGE_PROVIDER=liara
LIARA_ENDPOINT=https://storage.c2.liara.space
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
LIARA_BUCKET_NAME=raynew
STORAGE_REGION=default

# ============================================
# SSL CERTIFICATES (If mounting custom certs)
# ============================================
SSL_KEY_PATH=
SSL_CERT_PATH=
