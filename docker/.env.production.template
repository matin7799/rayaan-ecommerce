DOMAIN=raynew.ir

# Optional local postgres container credentials (used only with --profile local-db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rayaan_ecommerce

# Arvan Cloud managed PostgreSQL
DB_HOST=3cc0774f288046cfb5a3702eab7eca3a.db.arvandbaas.ir
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=default
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Security secrets (generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=
JWT_TEMP_SECRET=replace-with-strong-temp-secret

APP_BASE_URL=https:/raynew.ir
FRONTEND_URL=https:/raynew.ir
CORS_ORIGINS=https://raynew.ir

# Browser-side API URL (through Caddy)
NEXT_PUBLIC_API_URL=https://raynew.ir/api/v1
# Server-side API URL (inside Docker network)
INTERNAL_API_URL=http://backend:3002/api/v1

# Sms
SMS_USERNAME=
SMS_PASSWORD=
SMS_FROM_NUMBER=

# Token expiry (do not change unless you know what you're doing)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_TEMP_EXPIRY=10m

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_LENGTH=6
OTP_TTL=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW=600

# ============================================
# PAYMENT GATEWAY (Optional)
# ============================================
# Zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# STORAGE CONFIGURATION (Optional)
# ============================================
# For file uploads (Liara Object Storage / S3 Compatible)
STORAGE_PROVIDER=liara
LIARA_ENDPOINT=https://storage.c2.liara.space
LIARA_ACCESS_KEY=
LIARA_SECRET_KEY=
LIARA_BUCKET_NAME=raynew
STORAGE_REGION=default

# ============================================
# LOGGING & MONITORING (Optional)
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Sentry (Error Tracking)
SENTRY_DSN=

# ============================================
# SECURITY
# ============================================
# CORS allowed origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3002,http://localhost:3001

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
ENABLE_SWAGGER=true
ENABLE_WEBHOOKS=false
ENABLE_AUDIT_LOGS=true

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================
# Email service (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rayaan-ecommerce.com
