DOMAIN=your-domain.com

# Optional local postgres container credentials (used only with --profile local-db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=rayaan_ecommerce

# Arvan Cloud managed PostgreSQL
DB_HOST=your-arvan-db-host
DB_PORT=5432
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password
DB_NAME=your-db-name
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

# Security secrets (generate with: openssl rand -base64 32)
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
JWT_TEMP_SECRET=replace-with-strong-temp-secret

APP_BASE_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# Browser-side API URL (through Caddy)
NEXT_PUBLIC_API_URL=https://your-domain.com/api/v1
# Server-side API URL (inside Docker network)
INTERNAL_API_URL=http://backend:3002/api/v1
