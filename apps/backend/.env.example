# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3002
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# ============================================
# DATABASE CONFIGURATION (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=rayaan_ecommerce
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ============================================
# REDIS CONFIGURATION
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT CONFIGURATION
# ============================================
# IMPORTANT: Change these secrets in production!
# Generate strong secrets using: openssl rand -base64 32
JWT_SECRET=change-this-to-a-strong-secret-key-in-production
JWT_REFRESH_SECRET=change-this-to-a-strong-refresh-secret-in-production
JWT_TEMP_SECRET=change-this-to-a-strong-temp-secret-in-production

# Token expiry (do not change unless you know what you're doing)
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_TEMP_EXPIRY=10m

# ============================================
# OTP CONFIGURATION
# ============================================
OTP_LENGTH=6
OTP_TTL=120
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_MAX=3
OTP_RATE_LIMIT_WINDOW=600

# ============================================
# SMS PROVIDER (Optional - for OTP delivery)
# ============================================
# Supported providers: melipayamak, smsir
SMS_PROVIDER=melipayamak
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_FROM=
MELIPAYAMAK_OTP_BODY_ID=
MELIPAYAMAK_PATTERN_API_URL=

SMSIR_API_KEY=your_api_key
SMSIR_OTP_TEMPLATE_ID=123456
SMSIR_OTP_PARAMETER_NAME=CODE

# ============================================
# PAYMENT GATEWAY (Optional)
# ============================================
# Zarinpal
ZARINPAL_MERCHANT_ID=your-zarinpal-merchant-id
ZARINPAL_SANDBOX=true

# DigiPay
DIGIPAY_SANDBOX=true
DIGIPAY_CLIENT_ID=your-digipay-client-id
DIGIPAY_CLIENT_SECRET=your-digipay-client-secret
DIGIPAY_USERNAME=your-digipay-username
DIGIPAY_PASSWORD=your-digipay-password
DIGIPAY_MOCK_MODE=true
DIGIPAY_SELLER_ID=1
DIGIPAY_SUPPLIER_ID=1

# IDPay
IDPAY_API_KEY=your-idpay-api-key
IDPAY_SANDBOX=true

# ============================================
# STORAGE CONFIGURATION (Optional)
# ============================================
# For file uploads (Liara Object Storage / S3 Compatible)
STORAGE_PROVIDER=liara
STORAGE_ENDPOINT=https://storage.iran.liara.space
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_BUCKET=rayaan-ecommerce
STORAGE_REGION=us-east-1

# ============================================
# LOGGING & MONITORING (Optional)
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Sentry (Error Tracking)
SENTRY_DSN=

# ============================================
# SECURITY
# ============================================
# CORS allowed origins (comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:3002,http://localhost:3001

# Rate limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ============================================
# FEATURE FLAGS (Optional)
# ============================================
ENABLE_SWAGGER=true
ENABLE_WEBHOOKS=false
ENABLE_AUDIT_LOGS=true

# ============================================
# EXTERNAL SERVICES (Optional)
# ============================================
# Email service (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@rayaan-ecommerce.com

# Liara Object Storage
LIARA_ENDPOINT=https://storage.iran.liara.space
LIARA_ACCESS_KEY=your-access-key
LIARA_SECRET_KEY=your-secret-key
LIARA_BUCKET_NAME=rayaan-shop
